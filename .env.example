# Required runtime configuration
DATABASE_URL=
BOT_TOKEN=

# Bitrix integration
BITRIX_API_URL=https://order.evrasia.rest/api/internal/samzaberu/
# Set exactly one token source in production
BITRIX_API_TOKEN=
BITRIX_API_TOKEN_FILE=
BITRIX_API_TIMEOUT_MS=10000

# Inside 2.0 integration (server-to-server authentication)
INSIDE_API_BASE_URL=
INSIDE_API_TIMEOUT_MS=10000
# Comma-separated Inside fact_job_id values
INSIDE_SAMZABERU_FULL_ACCESS_JOB_IDS=
INSIDE_SAMZABERU_ASSIGNED_JOB_IDS=
# Optional user-ID overrides for staged rollout
INSIDE_SAMZABERU_FULL_ACCESS_USER_IDS=
INSIDE_SAMZABERU_ASSIGNED_USER_IDS=
# Keep false/empty after the Inside page is enabled
SAMZABERU_LEGACY_WEB_ENABLED=false

# Telegram access mapping
ALLOWED_TELEGRAM_USER_IDS=
VALERIA_TELEGRAM_ID=
NATALIA_TELEGRAM_ID=
EKATERINA_TELEGRAM_ID=

# Telegram escalation destinations (when notifier is enabled)
PERSONAL_CHAT_ID=
EMERGENCY_GROUP_CHAT_ID=

# Runtime options
TELEGRAM_BOT_POLLING=true
LOG_LEVEL=info
PORT=8080
NODE_ENV=production

# Tests only; never point this at production data
SAMZABERU_TEST_DATABASE_URL=
