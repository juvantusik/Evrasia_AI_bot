# Required runtime configuration
DATABASE_URL=
BOT_TOKEN=

# Bitrix integration
BITRIX_API_URL=https://order.evrasia.rest/api/internal/samzaberu/
# Set exactly one token source in production
BITRIX_API_TOKEN=
BITRIX_API_TOKEN_FILE=
BITRIX_API_TIMEOUT_MS=10000

# Existing SamZaberu Telegram access mapping
ALLOWED_TELEGRAM_USER_IDS=
VALERIA_TELEGRAM_ID=
NATALIA_TELEGRAM_ID=
EKATERINA_TELEGRAM_ID=
MARINA_TELEGRAM_ID=

# Evrasia AI Bot administration
# Optional comma-separated explicit Super Admin IDs.
# If empty, the first ID from ALLOWED_TELEGRAM_USER_IDS is used as bootstrap Super Admin.
SUPER_ADMIN_TELEGRAM_IDS=

# Corporate directory editors (v1.6)
# Optional exact comma-separated editor list. If empty, the bot allows the primary Super Admin
# plus Telegram ID 758415513 (Alena) to edit the corporate phone directory.
CORPORATE_DIRECTORY_EDITOR_TELEGRAM_IDS=

# Corporate communications configuration is managed by the bot itself.
# MegaFon group chat_id is saved to PostgreSQL after /bind_megafon_group is sent in the group.
# Corporate phone records are imported once into PostgreSQL; after that PostgreSQL is the master directory.

# Telegram escalation destinations (SamZaberu notifier)
PERSONAL_CHAT_ID=
EMERGENCY_GROUP_CHAT_ID=

# Runtime options
TELEGRAM_BOT_POLLING=true
LOG_LEVEL=info
PORT=8080
NODE_ENV=production

# Tests only; never point this at production data
SAMZABERU_TEST_DATABASE_URL=
