# Required runtime configuration
DATABASE_URL=
BOT_TOKEN=

# Bitrix integration
BITRIX_API_URL=https://order.evrasia.rest/api/internal/samzaberu/
# Set exactly one token source in production
BITRIX_API_TOKEN=
BITRIX_API_TOKEN_FILE=
BITRIX_API_TIMEOUT_MS=10000

# Existing SamZaberu Telegram access mapping
ALLOWED_TELEGRAM_USER_IDS=
VALERIA_TELEGRAM_ID=
NATALIA_TELEGRAM_ID=
EKATERINA_TELEGRAM_ID=
MARINA_TELEGRAM_ID=

# Evrasia AI Bot administration
# Comma-separated Telegram user IDs that can manage module access.
SUPER_ADMIN_TELEGRAM_IDS=

# MegaFon corporate communications
# Telegram supergroup chat ID, usually a negative integer.
MEGAFON_GROUP_CHAT_ID=
# Manager username without @ is preferred; both formats are accepted.
MEGAFON_MANAGER_USERNAME=
MEGAFON_GROUP_INVITE_URL=

# T2 corporate communications
T2_MANAGER_NAME=
T2_MANAGER_EMAIL=
T2_MANAGER_PHONE=

# Telegram escalation destinations (SamZaberu notifier)
PERSONAL_CHAT_ID=
EMERGENCY_GROUP_CHAT_ID=

# Runtime options
TELEGRAM_BOT_POLLING=true
LOG_LEVEL=info
PORT=8080
NODE_ENV=production

# Tests only; never point this at production data
SAMZABERU_TEST_DATABASE_URL=
