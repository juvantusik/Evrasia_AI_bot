# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS builder

WORKDIR /workspace

RUN corepack enable \
    && corepack prepare pnpm@10.28.2 --activate

COPY . .

RUN pnpm install --frozen-lockfile

ENV NODE_ENV=production
ENV PORT=8080
ENV BASE_PATH=/

# Добавлено 03.09.2026 ИТ Директор Евразии
RUN pnpm typecheck:libs \
    && pnpm --filter @workspace/api-server typecheck \
    && pnpm --filter @workspace/api-server exec node \
        --experimental-transform-types \
        --experimental-loader ./test-ts-resolver.mjs \
        --test src/services/bitrix-gateway.test.ts src/services/megafon-group-routing.test.ts src/services/restis-antifraud-gateway.test.ts src/services/bitrix-antifraud-card-gateway.test.ts src/services/bitrix-antifraud-account-gateway.test.ts src/services/bitrix-antifraud-device-gateway.test.ts src/services/trusted-device-snapshot-guard.test.ts src/services/anti-fraud-risk-engine.test.ts \
    && pnpm --filter @workspace/api-server build \
    && pnpm --filter @workspace/samzaberu-ops build \
    && pnpm --filter @workspace/samzaberu-ops exec vite build --config vite.phonebook.config.ts \
    && pnpm --filter @workspace/samzaberu-ops exec vite build --config vite.antifraud.config.ts

FROM node:22-bullseye-slim AS runtime

ARG VCS_REF=unknown
ARG VERSION=dev

LABEL org.opencontainers.image.source="https://github.com/juvantusik/Evrasia_AI_bot"
LABEL org.opencontainers.image.revision="${VCS_REF}"
LABEL org.opencontainers.image.version="${VERSION}"

ENV NODE_ENV=production
ENV PORT=8080
ENV STATIC_ROOT=/app/public

WORKDIR /app

COPY --from=builder --chown=node:node /workspace/artifacts/api-server/dist ./dist
COPY --from=builder --chown=node:node /workspace/artifacts/samzaberu-ops/dist/public ./public
COPY --from=builder --chown=node:node /workspace/artifacts/samzaberu-ops/dist-phonebook/public/phonebook.html ./public/phonebook.html
COPY --from=builder --chown=node:node /workspace/artifacts/samzaberu-ops/dist-phonebook/public/assets ./public/assets
# Добавлено 03.09.2026 ИТ Директор Евразии
COPY --from=builder --chown=node:node /workspace/artifacts/samzaberu-ops/dist-antifraud/public/antifraud.html ./public/antifraud.html
COPY --from=builder --chown=node:node /workspace/artifacts/samzaberu-ops/dist-antifraud/public/assets ./public/assets

USER node

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8080/api/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["node", "--enable-source-maps", "/app/dist/index.mjs"]
